__pycache__/

# Personal Claude Code permission overrides -- not shared with the team.
.claude/settings.local.json

# Sayana/Smriti importer scratch: the HTTP response cache that lets a timed-out
# run resume, and the standalone JSONL dump it writes beside the merged data.
# --cache-dir/--out-dir default to ./.httpcache and ./dump (relative to
# wherever the script is invoked from), so a run from the repo root instead
# of tools/sayana_smriti/ itself lands here instead -- both covered.
tools/sayana_smriti/.httpcache/
tools/sayana_smriti/dump/
tools/sayana_smriti/*.log
/.httpcache/
/dump/

# Wikisource Pancharatra importer's resume cache -- same idea, deleted
# automatically once a fetch completes; only ever present mid-run.
dge/data/**/*.progress.json

# Firebase tooling: installed locally, never committed.
node_modules/
dge/firebase/**/node_modules/
firestore-debug.log
firebase-debug.log
ui-debug.log
.firebase/
# Real project ids / aliases stay out of the repo — see .firebaserc.example
dge/firebase/.firebaserc
# Local-only Firebase Functions config/secret overrides (the Firebase CLI
# loads .env.local and .secret.local automatically for both `deploy` and
# `emulators:*`) -- .env.dge-test IS committed since it holds no secret,
# only OTP_PROVIDER=console for the "dge-test" project's e2e run; these two
# are the ones real values or per-developer overrides land in.
dge/firebase/functions/.env.local
dge/firebase/functions/.secret.local

# The built Sanskrit WordNet tree (tools/build_wordnet.py, 24 MB). Deliberately
# NOT on main: the published site sits about 1% under the GitHub Pages 1 GB
# limit and this would put it back over. It is published instead to this repo's
# own "wordnet-dist" branch — data only, which Pages never serves — and read
# from there over jsDelivr (appConfig.wordnetDataBase). Rebuild it here to
# develop against; .github/workflows/publish-wordnet.yml republishes the branch.
dge/data/_wordnet/

# Where tools/build_wordnet.py --download parks the IndoWordNet dump.
.cache/

# The bulk of the pending Dasa Sahitya local-asset imports (Android app DB,
# Firestore export, flat dump — see dasa_sahitya_local/ARCHITECTURE.md), same
# reasoning as the WordNet above: ~34 MB and growing with every new asset,
# too much for main's remaining GitHub Pages headroom. Published instead to
# this repo's own "dasa-sahitya-local-dist" branch, re-published by
# .github/workflows/publish-dasa-sahitya-local.yml. ARCHITECTURE.md and
# ALL_SOURCES_composer_registry.json stay on main — small, human-authored,
# and useful without a checkout of the dist branch. Rebuild the ignored
# subfolders here (or checkout dasa-sahitya-local-dist) to review or continue
# tools/dasa_sahitya/merge_confirmed_composers.py's work.
dge/data/dasa_sahitya_local/dasa1/
dge/data/dasa_sahitya_local/collection_padagalu/
dge/data/dasa_sahitya_local/raw_dump/

# Kavya import scratch: the report the importer writes when --report is left
# at its default. A build artifact, like the corpus itself.
_dump/

# Genie ASR voice-command benchmark (genie_asr_benchmark/): prototype/research
# work, kept out of dge/'s production code per CLAUDE.md. The Sarvam API key
# lives ONLY in this gitignored local env file, same .env.local convention as
# dge/firebase/functions/ above -- never commit it. Recorded audio samples and
# per-run result dumps are local test data, not source; the AI4Bharat local
# venv/model weights are large binary downloads, not source either.
genie_asr_benchmark/scripts/.env.local
genie_asr_benchmark/audio/**/*.wav
genie_asr_benchmark/audio/**/*.m4a
genie_asr_benchmark/audio/**/*.mp3
genie_asr_benchmark/results/*.json
genie_asr_benchmark/ai4bharat_local/venv/
genie_asr_benchmark/ai4bharat_local/models/
genie_asr_benchmark/ai4bharat_local/*.onnx
dge/data/kosha_r/

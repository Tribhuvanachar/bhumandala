   }
  },
  {
   "id": "TP_DAK_028",
   "reference": "Dhanushkoti · 28",
   "sanskrit_text": "पातिव्रत्यपरिक्षयाख्यललनादोषान्कुरच्छेदनं\nपाषाणीकृतगौतमार्यवनिताविज्ञानदानक्षमम् |\nसाम्राज्योचितभोग्यभोगविरसं श्रीराम तेsन्घ्रिं श्रये\nनैर्मल्याय निरन्तरस्मृतिकृते वैराग्यभाग्याय च",
   "tags": [
    "verse",
    "kavya"
   ],
   "notes": "",
   "references": [],
   "audio": [],
   "breadcrumb": [
    "Tīrthaprabandha",

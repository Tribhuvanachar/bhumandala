  {
   "id": "TP_DAK_013",
   "reference": "Nupuraganga Tirtha · 13",
   "sanskrit_text": "हरिनूपुरजातेsलं कुरु गङ्गे मनो मम |\nपरिहृत्य घनीभूतदुरितस्तोमकर्दमम्",

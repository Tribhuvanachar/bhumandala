  {
   "id": "TP_DAK_002",
   "reference": "Srirangam · 2",
   "sanskrit_text": "श्रुतिशतपरिगीतः शुद्धभावैर्गृहीतः\nकमलनिलयतातः कञ्जनेत्रः प्रतीतः |\nसकलजगदतीतः सर्वसम्पत्समेतः\nप्रविशतु मम चेतः प्रत्यहं रङ्गनाथः",
   "tags": [
    "verse",
    "kavya"
   ],
   "notes": "",
   "references": [],
   "audio": [],
   "breadcrumb": [
    "Tīrthaprabandha",

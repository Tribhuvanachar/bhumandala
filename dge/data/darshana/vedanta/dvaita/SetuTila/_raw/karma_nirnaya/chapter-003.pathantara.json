"bg_patha": "यतयः समुपासते॥”"
},
"dde21990-cb02-446e-bdf6-162d0ce038bc": {
"setutila": "इति श्रुतिः।",
"trk_patha": "इति श्रुतिः।",
"bg_patha": "इति च श्रुतिः।"
},
"6774b295-03b5-4f75-9d1a-ffb400deb362": {

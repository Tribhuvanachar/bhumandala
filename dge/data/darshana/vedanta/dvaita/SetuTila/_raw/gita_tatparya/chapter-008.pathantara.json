{
"0ec45464-5358-489d-9016-9b68e16b8263": {
"setutila": "मध्ये यत्किञ्चित्,",
"trk_patha": "मध्ये यत्किञ्चित्,",
"bg_patha": "मध्ये  किञ्चित्,"
},
"0cc8e211-8bc6-4931-9436-72dc113b6ac3": {
"setutila": "मुख्यत इति प्रसिद्धत्वात् तथैव परिहरति।",
"trk_patha": "मुख्यतः प्रसिद्धत्वात् तथैव परिहरति।",
"bg_patha": "मुख्यत इति प्रसिद्धत्वात् तथैव परिहार इति।"
},
"9c1e9b64-409d-40a6-a248-701abadd4167": {
"setutila": "इत्युक्ताक्षरादपि चोत्तम इति",
"trk_patha": "इत्युक्ताक्षरादपि चोत्तम इति",
"bg_patha": "इत्युक्तादक्षरादपि चोत्तम इति"
},
"67f0cc37-9862-4e24-aaae-e6cda28f3538": {
"setutila": "केवलं तत्कालस्मरणं",
"trk_patha": "केवलं तत्कालस्मरणं",
"bg_patha": "केवलतत्कालस्मरणं"
},
"bad8a7e0-9a36-43e6-9b21-a24ad060e4a7": {
"setutila": "त्यागान्नित्यं हरिस्मृतेः।",
"trk_patha": "त्यागान्नित्यं हरिस्मृतेः।",
"bg_patha": "त्यागान्नित्यहरिस्मृतेः।"
},
"864177a7-31af-434c-bb0c-27283034b2da": {
"setutila": "अप्राकृतदेहः",
"trk_patha": "अप्राकृतदेहः",
"bg_patha": "अप्राकृतदेहम्"
},
"4c5b86fe-c80c-44b7-8fac-83a85d4552e4": {
"setutila": "‘अव्यक्ताद् व्यक्तयः सर्वाः प्रभवन्त्यहरागमे।",
"trk_patha": "‘अव्यक्ताद् व्यक्तयः सर्वाः प्रभवन्त्यहरागमे।",
"bg_patha": "‘अव्यक्ताद् व्यक्तयः सर्वाः प्रभवन्ति"
},
"3fe19c0e-83bf-46cb-8202-d24dc792de9b": {
"setutila": "रात्र्यागमे प्रलीयन्ते तत्रैवाव्यक्तसञ्ज्ञके’",
"trk_patha": "रात्र्यागमे प्रलीयन्ते तत्रैवाव्यक्तसञ्ज्ञके’",
"bg_patha": "रात्र्यागमे प्रळीयन्ते’"
},
"d4235d01-49c0-4dfc-8d24-0f654aee962c": {
"setutila": "नहि विरिञ्चाहन्येव सर्वव्यक्तिलयः।",
"trk_patha": "नहि विरिञ्चाहन्येव सर्वव्यक्तिलयः।",
"bg_patha": "नहि विरिञ्चाहन्येव सर्वव्यक्तलयः।"
},
"4b0c1772-b0b6-4761-ae75-40af9236d484": {
"setutila": "अहः श्वासो",
"trk_patha": "अहश्चासौ",
"bg_patha": "अहः श्वासो"
},
"6c2ee729-3ae3-473e-98be-2475fe597991": {
"setutila": "सायुज्यं गच्छत्येतौ वै",
"trk_patha": "सायुज्यं सलोकतामप्नोत्येतौ वै",
"bg_patha": "सायुज्यं गच्छत्येतौ वै"
}
}
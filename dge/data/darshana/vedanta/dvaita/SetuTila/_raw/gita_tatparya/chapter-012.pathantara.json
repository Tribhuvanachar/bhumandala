"bg_patha": "गमयेत्"
},
"14b6f8ee-e38b-475a-91c0-75d61fcc0ba4": {
"setutila": "ते त्वपलापकत्वादतीव साहसिका इति",
"trk_patha": "ते त्वपलापकत्वादतीव साहसिका इति",
"bg_patha": "ते त्वपलापकत्वादेवातिसाहसिका इति"
},
"06d41325-64e2-4808-b10d-563301ed2841": {
"setutila": "सा हि",
"trk_patha": "सा हि",
"bg_patha": "साऽपि"
},
"d7b92123-22e1-4128-8c7f-f159f7fff8b2": {
"setutila": "तस्माज्ज्ञानाद् भवेन्मुक्तिस्त्यागाद् ध्यानयुतात् स्फुटम्॥”",
"trk_patha": "तस्माज्ज्ञानाद् भवेन्मुक्तिस्त्यागाद् ध्यानयुतात् स्फुटम्॥”",
"bg_patha": "तस्माज्ज्ञानाद् भवेन्मुक्तिस्त्यागध्यानयुतात् स्फुटम्॥”"
},
"9ab2450c-9baf-4ba0-a8b0-a265238bc1ae": {
"setutila": "भगवत्समर्पणरूपेण च त्यागी।",
"trk_patha": "भगवत्समर्पणरूपेण च त्यागी।",
"bg_patha": "भगवति समर्पणरूपेण च त्यागी।"
},
"d95cbf75-c4c3-42a0-a12f-20273baa9a58": {
"setutila": "तथोच्यते यथाऽल्पस्वो निःस्व इत्युच्यते जनैः।",
"trk_patha": "तथोच्यते यथाऽल्पस्वो निःस्व इत्युच्यते जनैः।",
"bg_patha": "तथोच्यते यथाऽल्पस्वो निःस्व इत्युच्यते बुधैः।"
}

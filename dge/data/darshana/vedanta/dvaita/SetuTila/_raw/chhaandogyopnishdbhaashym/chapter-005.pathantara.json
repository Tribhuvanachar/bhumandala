"bg_patha": "निह्लादाद्ध्रादुनिस्तथा।"
},
"2e96508d-feb4-4e17-847d-7af77449182c": {
"setutila": "सर्वान्तःकृच्च",
"trk_patha": "सर्वान्तःकृच्च",
"bg_patha": "स चान्तःकृच्च"
},
"7a7ac277-cfb6-4be6-8127-3fe3c590732d": {
"setutila": "ज्ञानिप्राप्यं",

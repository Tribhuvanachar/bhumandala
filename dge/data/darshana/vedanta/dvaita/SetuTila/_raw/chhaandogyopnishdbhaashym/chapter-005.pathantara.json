"trk_patha": "रश्मी रतिशरूपतः।",
"bg_patha": "रश्मिः स रतिरूपतः।"
},
"55fe3fb9-89e2-4f74-9b7e-f00f671c291f": {
"setutila": "परः सुखम्।",
"trk_patha": "परः सुखम्।",
"bg_patha": "परं सुखम्।"
},
"e4e70473-e389-49f5-be17-52a72e1f0b7a": {
"setutila": "निर्ह्रादाद्ध्रादुनिस्तथा।",

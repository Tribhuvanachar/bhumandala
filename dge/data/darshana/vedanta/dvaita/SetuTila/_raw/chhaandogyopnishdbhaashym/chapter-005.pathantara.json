"bg_patha": "पूर्वबालानां केवलप्राणतो"
},
"af1d0e91-b449-4546-8088-38d5af8a006c": {
"setutila": "भक्त्या स्यात् तत्प्रसादतः।",
"trk_patha": "भक्त्या स्यात् तत्प्रसादतः।",
"bg_patha": "तद्भक्त्या स्यात् प्रसादतः।"
},
"c03e6395-3f9c-4ce6-9935-2ae0624dbc38": {
"setutila": "प्राणविद्यायां",
"trk_patha": "प्राणविद्यायां",

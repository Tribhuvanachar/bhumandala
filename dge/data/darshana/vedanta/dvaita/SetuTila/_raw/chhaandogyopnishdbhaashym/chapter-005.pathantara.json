"bg_patha": "वस्तिराकाशवाय्वोश्च"
},
"e7ac7ddf-2273-4782-8fee-798137cb112e": {
"setutila": "पृथिवीनामा",
"trk_patha": "पृथिवीनामा",
"bg_patha": "पृथिवी नाम्ना"
},
"f734783d-205e-40a6-9a78-7167ea330981": {
"setutila": "किमानन्दस्वरूपतः।",
"trk_patha": "किमानन्दस्वरूपतः।",
"bg_patha": "किमानन्दिस्वरूपतः।"
},
"6e2ac08b-d188-42b7-bf3f-7e14efce2e62": {
"setutila": "इति वैश्वानरविद्यायाम्।",
"trk_patha": "इति वैश्वानरविद्यायाम्।",

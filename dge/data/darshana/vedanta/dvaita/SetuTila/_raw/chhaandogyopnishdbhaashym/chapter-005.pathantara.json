{
"508eb7a9-554c-461a-b6ff-5f200f4a72a8": {
"setutila": "श्रेष्ठं ज्येष्ठमखिलदेवानां",
"trk_patha": "श्रेष्ठं ज्येष्ठमखिलदेवानां",

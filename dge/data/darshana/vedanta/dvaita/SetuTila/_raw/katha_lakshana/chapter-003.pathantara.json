{
"0554953e-72df-4e04-988c-c00b9ce1f4c8": {
"setutila": "निगूहितम्।",
"trk_patha": "निगूहितम्।",
"bg_patha": "निगूहितुम्।"
},
"2a789877-e87e-4ce9-bb4d-04f0fecb9817": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "विद्यापरीक्षापूर्वैव वितण्डा जल्प एव च।"
},
"a681f112-8f5b-4756-9c4e-c3f2f4e3c9fd": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "उच्चनीचत्वनिर्णीतिर्यतो जयपराजयौ॥ *॥"
},
"bf2fb705-6abc-4414-9936-5b0142d32560": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "विनैव तत्वनिर्णीतिं नहि जल्पादिना क्वचित्।"
},
"99cc1259-fee5-4a5e-b9a4-d9d3be4178d3": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "उच्चनीचत्वविज्ञानमिति विद्यापरीक्षणम्॥ *॥"
},
"d3289773-a99d-44f6-97b2-fd95137cb0e0": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "वादेन चोच्चनीचत्वविज्ञानं भवति स्फुटम्।"
},
"f8b72c1c-2b16-430f-96b4-de3c734c09ce": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "इति वादस्य पूर्वत्वं तत्सिद्धौ व्यर्थताऽन्ययोः॥ *॥"
},
"2337b016-049f-43c7-8edc-5e377f38363b": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "बहुविद्यत्वसिद्धौ तु नैव वादोऽपि कारणम्।"
},
"ea57e63a-69d9-48d7-aff3-18bd1be9042c": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "सभासभापप्राश्नीकपूर्वस्तु स्पर्धिनामपि॥ *॥"
},
"fb032481-f6e8-472d-ba3c-e1d9164ae3eb": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "वाद एवोभयार्थः स्यान्निर्णीतिजयकारकः।"
},
"5fc880d1-5635-4cc9-82ae-020a9b8ed783": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "तत्वाप्रकाश एवैको वितण्डाजल्पयोः फलम्॥ *॥"
},
"13f0b4b3-4af0-4fff-a694-d5d8cfe2a730": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "विना वादेन विद्याया यदि शक्यं परीक्षणम्।"
},
"aacecadf-a43c-48b7-8af1-62b9b63b3d73": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "स्याज्जल्पादिरपि क्वापि वाद एवान्यथा भवेत्॥ *॥"
},
"91fe206d-8bde-44cf-9e67-3d97299577a7": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "जल्प इत्यपि नाम स्याद् वादस्यैतादृशस्य तु।"
},
"a5a81bb2-08ca-4283-bd2f-911c4e792074": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "प्रतिज्ञामात्रसाध्यत्वमपि स्याद् याज्ञवल्क्यवत्॥ *॥"
},
"a07173a8-bb40-4e35-a315-92d746ef3287": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "संवादे वादिनोः क्वापि विवादे हेतुरिष्यते।"
},
"95e7c916-a2bf-46fb-98c7-da4350e88a17": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "सभा सभापतिश्चैव प्राश्निकाश्चैव वैष्णवाः॥ *॥"
},
"f01e6eb9-a414-4619-8893-c8a1fe923ca2": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "रागद्वेषविहीनाश्च स्युः सभ्याः सर्ववेदिनः।"
},
"67b7f1ea-06b9-4f59-9f0a-7b112189743f": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "प्राश्निकाश्चैतदज्ञाने सभ्याश्चैषां च दूरगाः।"
},
"fb3c468f-2488-4fc9-97ad-b276cd0c10db": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "प्रमाणं निर्णयाय स्युः पक्षपातविवर्जिताः॥ *॥"
}
}
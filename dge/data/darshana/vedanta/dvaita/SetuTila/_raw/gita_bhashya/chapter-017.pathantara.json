"bg_patha": "इति ह्यानभिम्लातश्रुतिः।"
},
"8a565fed-7c58-4aa7-8531-680d7ccfb7b5": {
"setutila": "पक्वा भवन्ति।",
"trk_patha": "पक्वा भवन्ति।",
"bg_patha": "पक्ता भवन्ति।"
},
"2009c591-2677-48b3-8dd6-6eda4d13c02a": {
"setutila": "इत्यभिधानम्।",
"trk_patha": "इत्यभिधानम्।",
"bg_patha": "इति ह्यभिधानम्।"
},
"8bf6ac17-1ccf-4b6a-9e84-57e28f430761": {
"setutila": "इति भाल्लवेयश्रुतिः।",

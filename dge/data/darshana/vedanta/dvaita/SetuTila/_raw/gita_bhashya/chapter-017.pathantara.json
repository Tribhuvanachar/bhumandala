{
"68cee237-0018-48e5-b57b-4d34e5b296a5": {
"setutila": "वेदोज्झितांस्तान्",
"trk_patha": "वेदोज्झितांस्तान्",
"bg_patha": "वेदोज्झांस्तान्"
},
"f4348deb-6e4e-4f21-a35b-262539b9b8a6": {
"setutila": "इति माधुच्छन्दसश्रुतिः।",
"trk_patha": "इति माधुच्छन्दसश्रुतिः।",
"bg_patha": "इति च माधुच्छन्दसश्रुतिः।"
},
"5f2d5cf9-e8f0-46d8-aea5-90243007a363": {
"setutila": "“वेदोऽखिलो धर्ममूलं स्मृतिशीले च तद्विदाम्”",
"trk_patha": "“वेदोऽखिलो धर्ममूलं स्मृतिशीले च तद्विदाम्”",
"bg_patha": "“वेदो धर्ममूलम्। तद्विदां च स्मृतिशीले”"
},
"19580070-fdbb-4506-bf81-64381033e33f": {
"setutila": "इति च भागवते",
"trk_patha": "इति च भागवते",
"bg_patha": "इति भागवते"
},
"72539ecd-17e8-464c-9077-6186e4de6463": {
"setutila": "इति ह्यनभिम्लानश्रुतिः।",

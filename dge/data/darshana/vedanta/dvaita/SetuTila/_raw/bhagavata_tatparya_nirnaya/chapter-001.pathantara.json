{
"e6f6a896-4a5d-4f95-bc47-462644fbb285": {
"setutila": "युक्तितश्चेतृपूर्वादेः श्रीब्रह्मभवपूर्विणः॥",
"trk_patha": "युक्तितश्चेतृपूर्वादेः"
},
"44be568b-5805-4461-9170-3a254e945fca": {
"setutila": "ते यान्ति परमं स्थानं मयैवोदितमञ्जसा॥”",
"bg_patha": "ममैवोदितमञ्जसा"
},
"e4f73ae9-fa44-45fa-a61f-3cff8aaa6905": {
"setutila": "इत्यादि।",
"trk_patha": "इत्यादि"
},
"3697c85a-dffe-4631-8aea-7568b524d922": {
"setutila": "“उत्तमेष्वात्मनो नित्यं मात्सर्यं परिवर्जयेत्।",
"bg_patha": "उत्तमे स्वात्मनो"
},
"91ef0049-904a-4270-9375-3e0b1b4b281d": {
"setutila": "भारतादीनि यानीह तथा भागवतं भुवि॥",
"bg_patha": "भारताख्यानि"
},
"a024cb6d-1a11-4e52-9b17-3c965cb466c4": {
"setutila": "नित्यज्ञानस्य चिद्दृष्टिर्लोकदृष्टिव्यपेक्षया।",
"trk_patha": "चिद्दृष्टिर्लोकदृष्टिव्यपेक्षया"
}
}
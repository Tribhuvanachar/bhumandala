"trk_patha": "गण्डयोरोष्ठयोर्दन्तपङ्क्त्योर्मूर्ध्नि च",
"bg_patha": "गण्डयोरोष्ठयोर्दन्तपङ्क्त्योर्मूर्धनि"
},
"89a01215-2008-4a40-8c53-236907708438": {
"setutila": "तारैस्त्रिर्द्वादशावृत्तैर्द्व्येकद्वादशकेन",
"trk_patha": "तारैस्त्रिर्द्वादशावृत्तैर्द्व्येकद्वादशकेन",
"bg_patha": "तारत्रिद्वादशावर्तैर्द्व्येकद्वादशकेन"
},
"f37b5cae-f187-4299-b79b-56345c0c2b63": {
"setutila": "एकपञ्चाशद्वर्णानां चतुर्विंशतिमूर्तयः।",
"trk_patha": "एकपञ्चाशद्वर्णानां चतुर्विंशतिमूर्तयः।",
"bg_patha": "एकपञ्चाशदर्णानां चतुर्विंशति मूर्तयः।"
},
"1efc94ee-3935-4192-98b1-007eead22682": {
"setutila": "पूर्वोक्तविधिनाऽभ्यर्च्य प्रतिमां शिष्यमेव वा।",
"trk_patha": "पूर्वोक्तविधिनाऽभ्यर्च्य प्रतिमां शिष्यमेव वा।",
"bg_patha": "पूर्वोक्तविधिनाऽभ्यर्च्य प्रतिमां शिष्यमेव च।"
},
"5ebb99f5-d74e-4f57-9e22-eaefdefeabb2": {
"setutila": "कलशः कीर्तिमायुष्यं प्रज्ञां मेधां श्रियं बलम्।",
"trk_patha": "कलशः कीर्तिमायुष्यं प्रज्ञां मेधां श्रियं बलम्।",
"bg_patha": "कलशः कीर्तिमायुश्च प्रज्ञां मेधां श्रियं भगम्।"
},
"028d58b2-2fd9-4709-afa4-50c0294e9194": {
"setutila": "चतुर्विंशाङ्गुलं वा तद्विस्तारो द्वादशैव वा॥ १७॥",
"trk_patha": "चतुर्विंशाङ्गुलं वा तद्विस्तारो द्वादशैव वा॥ १७॥",
"bg_patha": "चतुर्विंशाङ्गुला वा तद्विस्तारो द्वादशैव वा॥ १७॥"
},
"a54519ea-de89-4787-8a65-696041a11394": {
"setutila": "तदात्मनि हरिं ध्यात्वा कुण्डे देवीं श्रियं तथा।",
"trk_patha": "तदात्मनि हरिं ध्यात्वा कुण्डे देवीं श्रियं तथा।",
"bg_patha": "तदात्मनि हरिं ध्यायेत् कुण्डे देवीं श्रियं तथा।"
},
"b74d7289-849c-48e4-980e-883e22de099c": {
"setutila": "विष्णुवीर्यात्मकं वह्निं निक्षिपेत् प्रणवेन तु॥ १९॥",
"trk_patha": "विष्णुवीर्यात्मकं वह्निं निक्षिपेत् प्रणवेन तु॥ १९॥",
"bg_patha": "विष्णुवीर्यात्मकं वह्निं निक्षिपेत् प्रणवेन ह॥ १९॥"
},
"b9cd2181-1ee7-419c-bbeb-e2abe0e439d9": {
"setutila": "तिलैर्वा तण्डुलैर्वाऽपि मधुरैस्त्रिभिरेव वा॥ २१॥",
"trk_patha": "तिलैर्वा तण्डुलैर्वाऽपि मधुरैस्त्रिभिरेव वा॥ २१॥",
"bg_patha": "तिलैर्वा तण्डुलैर्वाऽथ मधुरैस्त्रिभिरेव वा॥ २१॥"
},
"eb8f0e30-6eac-4b76-ac84-60955557db77": {
"setutila": "ब्रह्मवृक्षसमिद्भिर्वा समिद्भिर्वाऽमृतोद्भवैः।",
"trk_patha": "ब्रह्मवृक्षसमिद्भिर्वा समिद्भिर्वाऽमृतोद्भवैः।",
"bg_patha": "ब्रह्मपत्रसमिद्भिर्वा समिद्भिर्वाऽमृतोद्भवैः।"
},
"3f4a40a6-224a-447f-a4db-1e6ea06147e1": {
"setutila": "एवमेव च दीक्षायामाज्येनैवाहुतिक्रिया।",
"trk_patha": "एवमेव च दीक्षायामाज्येनैवाहुतिक्रिया।",
"bg_patha": "एवमेव तु दीक्षायामाज्येनैव हुतिक्रिया।"
}

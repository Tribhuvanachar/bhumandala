},
"5f11a71e-9eda-4ff6-bdbf-6a77e6f64818": {
"setutila": "सोमश्च पूज्यः कोणेषु वह्न्याद्याः कोणदेवताः॥ ६५॥",
"trk_patha": "सोमश्च पूज्यः कोणेषु वह्न्याद्याः कोणदेवताः॥ ६५॥",

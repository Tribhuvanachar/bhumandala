},
"2d3669d2-9d3e-45cb-b3f6-227c13b20afb": {
"setutila": "ततस्तु मण्टपं कुर्यात् प्रतिष्ठायाः सुलक्षणम्॥ ६३॥",
"trk_patha": "ततस्तु मण्टपं कुर्यात् प्रतिष्ठायाः सुलक्षणम्॥ ६३॥",

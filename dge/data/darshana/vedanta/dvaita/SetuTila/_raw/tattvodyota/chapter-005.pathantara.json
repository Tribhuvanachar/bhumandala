"b8701655-7045-4629-ab36-38804ab0634c": {
"setutila": "तेन भवति।",
"trk_patha": "तेन भवति।",
"bg_patha": "भवति।"
},
"0ee532b7-4ae4-462f-bd37-ca7d7d425192": {
"setutila": "स्वविषयप्रकाशत्वाभावात् परविषयप्रकाशत्वाभावाच्चानैकान्तिकमेव।",
"trk_patha": "स्वविषयप्रकाशत्वाभावात् परविषयप्रकाशत्वाभावाच्चानैकान्तिकमेव।",
"bg_patha": "स्वविषयत्वाभावात् परविषयत्वाभावाच्चानैकान्तिकमेव।"
},
"c564c64d-fcbe-4599-910a-b0fc1dfca455": {
"setutila": "मिथ्याभूतपरविषयत्वं",

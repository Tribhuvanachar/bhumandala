"185862e9-a03c-4d22-9228-3931b5100f5f": {
"setutila": "अधुनोच्छकटं लो ली पादाङ्गुष्ठेन वातपेशशकटं लोली।",
"trk_patha": "अधुनोच्छकटं लो ली पादाङ्गुष्ठेन वातपेशशकटं लोली।",
"bg_patha": "अधुनोच्छकटं ळो ळी पादाङ्गुष्ठेन वातपेशशकटं ळोळी।"
},
"b763c2b3-c167-49ce-ac50-dc7ec6041d77": {

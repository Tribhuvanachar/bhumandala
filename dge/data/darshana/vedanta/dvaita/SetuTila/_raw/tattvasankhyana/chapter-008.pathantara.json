{
"f1a7d2a7-e383-4b4d-8054-ad4f7a34c8ab": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "इत्यादि तत्त्वसङ्ख्याने।"
},
"f431549a-0d42-4415-bd67-96c99d83ccaa": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "स्वजनोदधिसंवृद्धिपूर्णचन्द्रो गुणार्णवः।"
},
"edcb2ae8-fcc0-4726-bb29-31faccc6006d": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "अमन्दानन्दसान्द्रो नः सदाऽव्यादिन्दिरापतिः॥"
},
"dee22062-2f69-4f6a-ab97-c01cd3c54bc0": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "रमाचकोरीविधवे दुष्टसर्पोदवह्नये।"
},
"c52e6fb5-c843-4936-92fa-a0a984d4b022": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "सत्पान्थजनगेहाय नमो नारायणाय ते॥"
},
"572e4b2a-87bd-4699-8050-52e96bac3c03": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "चिदचिद्भेदमखिलं विधायाधाय भुञ्जते।"
},
"e57c2b7b-54f4-42d0-a7ce-5c9f3f9f2e80": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "अव्याकृतगृहस्थाय रमाप्रणयिने नमः॥"
},
"83655b23-618e-4d0e-9df0-955bd46623de": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "अमन्दगुणसारोऽपि मन्दहासेन वीक्षितः।"
},
"7e87cbd3-c709-4373-8d9d-31e8f2b93ce0": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "नित्यमिन्दिरयाऽऽनन्दसान्द्रो यो नौमि तं हरिम्॥"
},
"aec4b33c-be63-4199-900f-acab9ea48d6e": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "वशी वशो न कस्यापि योऽजितो विजिताखिलः।"
},
"4af74435-8ed5-4e40-84c0-71d5e881ce33": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "सर्वकर्ता न क्रियते तं नमामि रमापतिम्॥"
},
"45017a55-4c56-499b-91b4-c57bd336bfb2": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "अगुणाय गुणोद्रेकस्वरूपायादिकारिणे।"
},
"00e8ddc1-37ec-41ce-8201-e1283c951c46": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "विदारितारिसङ्घाय वासुदेवाय ते नमः॥"
},
"d8637a84-c855-4dcc-8fb0-912fbc315a3f": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "आदिदेवाय देवानां पतये सादितारये।"
},
"be151e7c-a3d3-46db-bb8e-19178d7bf85b": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "अनाद्यज्ञानपाराय नमः पारावराश्रय॥"
},
"cd16a6d9-7fa2-4db1-9699-b1ce45a1d916": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "अजाय जनयित्रेऽस्य विजिताखिलदानव।"
},
"f05ca609-5707-4b92-965f-7ab1a2df6605": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "अजादिपूज्यपादाय नमस्ते गरुडध्वज॥"
},
"d116fab9-9425-4856-8c5f-9df78d0cbdbf": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "रमारमण एवैको रणजिच्छरणं सताम्।"
},
"04525a05-f9fa-4a5e-bceb-8c42962cd3bd": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "कारणं कारणस्यापि तरुणादित्यसप्रभः॥"
},
"98a5c70e-1444-4345-95d5-ce22bec5eba1": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "इन्दिरामन्दसान्द्राग्र्यकटाक्षप्रेक्षितात्मने।"
},
"0fa8ba99-7e63-4539-a85a-f0196030372f": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "अस्मदिष्टैककार्याय पूर्णाय हरये नमः॥"
},
"f68239d4-cfa3-4b36-9da3-7a5fb67a43b2": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "एवंविधः परो विष्णुरव्याच्छ्रीपुरुषोत्तमः।"
},
"2640de82-c3c2-48a7-9b4c-8f09614b9cc4": {
"setutila": "-",
"trk_patha": "-",
"bg_patha": "तमहं सर्वदा वन्दे श्रीनिकेतं परं हरिम्॥"
},
"9248e35a-b733-4ec3-9423-87ad4cbc6c54": {
"setutila": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितं तत्त्वसङ्ख्यानं सम्पूर्णम्॥",
"bg_patha": "॥ इति तत्त्वसङ्ख्यानं समाप्तम्॥"
}
}
"cd81aea4-b856-401f-ac26-9b17130cd339": {
"setutila": "प्रारब्धकर्मणोऽन्यस्य ज्ञानादेव परिक्षयः।",
"trk_patha": "प्रारब्धकर्मणोऽन्यस्य ज्ञानादेव परिक्षयः।",
"bg_patha": "प्रारब्धकर्मणोऽन्यस्य ज्ञानेन स्यात् परिक्षयः।"
},
"dad0b350-be79-4f1e-a344-c4682cf664ef": {
"setutila": "उत्तरेषूत्तरेष्वेवं यावद् वायुं विमुक्तिगाः।",
"trk_patha": "उत्तरेषूत्तरेष्वेवं यावद् वायुं विमुक्तिगाः।",
"bg_patha": "उत्तरेषूत्तरेष्वेव यावद् वायुं विमुक्तिगाः।"
},
"bab3d567-62af-43b2-800e-676d7dca173e": {
"setutila": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते ब्रह्मसूत्रसङ्ग्रहभाष्ये चतुर्थोऽध्यायः॥",
"trk_patha": "॥ इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्राणुभाष्ये श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते चतुर्थोऽध्यायः॥",
"bg_patha": "[-]"
},
"6731604c-7615-41a8-9ff4-9bc5680a03a5": {
"setutila": "॥ समाप्तश्चायं ग्रन्थः॥",
"trk_patha": "[-]",
"bg_patha": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितः सर्वशास्त्रार्थसङ्ग्रहः समाप्तः॥"
}
}
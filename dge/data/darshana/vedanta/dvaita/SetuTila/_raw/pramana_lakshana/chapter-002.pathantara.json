{
"506626d2-3dc9-4254-a5b3-8e88b9045a3b": {
"setutila": "योगिज्ञानमृजूनामनादिनित्यम्।",
"trk_patha": "योगिज्ञानमृजूनामनादिनित्यम्।",
"bg_patha": "योगिज्ञान ऋजूनामनादिनित्यम्।"
},
"49c78fe1-471f-4429-a251-2759778ccf06": {
"setutila": "अयोगिज्ञानमुत्पत्तिविनाशवत्।",
"trk_patha": "अयोगिज्ञानमुत्पत्तिविनाशवत्।",
"bg_patha": "अयोगिज्ञानमुत्पत्तिनाशवत्।"
},
"e6e84735-0d05-4b4b-9208-6bb3d91afa10": {
"setutila": "निर्दोषार्थेन्द्रियसन्निकर्षः प्रत्यक्षम्।",
"trk_patha": "निर्दोषार्थेन्द्रियसन्निकर्षः प्रत्यक्षम्।",
"bg_patha": "निर्दोषोऽर्थेन्द्रियसन्निकर्षः प्रत्यक्षम्।"
},
"f949ae0c-b634-45ae-96d4-91f2fbb41deb": {
"setutila": "निदोषोपपत्तिरनुमानम्।",
"trk_patha": "निदोषोपपत्तिरनुमानम्।",
"bg_patha": "निदोषोपपत्तिरनुमा।"
},
"99991301-3aae-4b47-a2bd-c14f5d10c152": {
"setutila": "अर्थापत्त्युपमे अनुमाविशेषः।",
"trk_patha": "अर्थापत्त्युपमे अनुमाविशेषः।",
"bg_patha": "अर्थापत्त्युपमेऽनुमाविशेषः।"
},
"f3a8e88d-7a6b-4323-8e8c-e699fc6b6729": {
"setutila": "आत्मान्योन्याश्रयताचक्रकानवस्थाकल्पनागौरवश्रुतदृष्टहानादयो",
"trk_patha": "आत्मान्योन्याश्रयचक्रकानवस्थाकल्पनागौरवश्रुतदृष्टहानादयो",
"bg_patha": "आत्मान्योन्याश्रयताचक्रकानवस्थाकल्पनागौरवश्रुतदृष्टहानादयो"
},
"9fc2aaf6-39b7-4d31-a798-cc92b6fc872c": {
"setutila": "उपक्रमोपसंहारतदैकरूप्याभ्यासापूर्वताफलार्थवादाश्च।",
"trk_patha": "उपक्रमोपसंहारतदैकरूप्याभ्यासापूर्वताफलार्थवादाश्च।",
"bg_patha": "उपक्रमोपसंहारतदैकरूप्याभ्यासापूर्वताफलार्थवादाः।"
},
"676bb1da-0f28-437e-8038-65b56b7e21ae": {
"setutila": "प्रतिज्ञायां",
"trk_patha": "प्रतिज्ञायां",
"bg_patha": "प्रतिज्ञाया"
},
"fc1d01dd-f689-498f-a4eb-7528bc7e6b39": {
"setutila": "न्यूनाधिके",
"trk_patha": "न्यूनाधिके",
"bg_patha": "न्यूनाधिक्ये"
},
"9e77fda5-587b-4728-97be-71c9a6461f3c": {
"setutila": "संवादानुक्तियुता निग्रहाः।",
"trk_patha": "संवादानुक्तियुता निग्रहाः।",
"bg_patha": "संवादानुक्तियुतास्त एव निग्रहाः।"
}
}
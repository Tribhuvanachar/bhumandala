{
"df1db6e5-71b6-404b-a0cf-b3bd0fd7cc4b": {
"setutila": "सुजनोदधिसंवृद्धिपूर्णचन्द्रो",
"trk_patha": "सुजनोदधिसंवृद्धिपूर्णचन्द्रो",
"bg_patha": "स्वजनोदधिसंवृद्धिपूर्णचन्द्रो"
},
"ba25472b-f031-42f7-a775-967d4393d5ea": {
"setutila": "प्रीयतामिन्दिरापतिः॥",
"trk_patha": "प्रीयतामिन्दिरापतिः॥",
"bg_patha": "सदाऽव्यादिन्दिरापतिः॥"
},
"183a0116-4acb-468f-b334-8388de786af8": {
"setutila": "दुष्टदर्पोदवह्नये।",
"trk_patha": "दुष्टदर्पोदवह्नये।",
"bg_patha": "दुष्टसर्पोदवह्नये।"
},
"82d84515-a095-49db-a57c-0335fdb43177": {
"setutila": "वशे",
"trk_patha": "वशे",
"bg_patha": "वशो"
},
"5ffa2f04-1ff1-4e9b-949e-1f9d5743fac7": {
"setutila": "नमो वरवराय ते॥",
"trk_patha": "नमो वरवराय ते॥",
"bg_patha": "नमः पारावराश्रय॥"
},
"799dc16a-103e-4799-a794-af3370f5f061": {
"setutila": "[-]",
"trk_patha": "[-]",
"bg_patha": "रमारमण एवैको रणजिच्छरणं सताम्।"
},
"102c5e5c-3cd9-4437-965b-9f2cfe5c8bb3": {
"setutila": "[-]",
"trk_patha": "[-]",
"bg_patha": "कारणं कारणस्यापि तरुणादित्यसप्रभः॥"
},
"19d7bd77-35b1-4202-813c-dabf36a10e3b": {
"setutila": "[-]",
"trk_patha": "[-]",
"bg_patha": "एवंविधः परो विष्णुरव्याच्छ्रीपुरुषोत्तमः।"
},
"65671eec-59f7-48c5-bc0a-e2daa065a5fc": {
"setutila": "[-]",
"trk_patha": "[-]",
"bg_patha": "तमहं सर्वदा वन्दे श्रीनिकेतं परं हरिम्॥"
},
"93d259e1-3ded-4330-a58e-4d452b368b80": {
"setutila": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते द्वादशस्तोत्रे द्वितीयोऽध्यायः॥",
"trk_patha": "॥ इति श्रीमद्द्वादशस्तोत्रे द्वितीयोऽध्यायः॥",
"bg_patha": "[-]"
}
}
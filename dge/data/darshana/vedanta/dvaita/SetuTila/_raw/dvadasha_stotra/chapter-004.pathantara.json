},
"a92f8dfc-f3a5-44e0-af06-d052ae90b0f8": {
"setutila": "इति देववरस्य हरेः स्तवनं कृतवान् मुनिरुत्तममादरतः।",
"bg_patha": "[-]"
},
"27692e5b-82a3-4c4c-a58d-dcabe4715d80": {
"setutila": "सुखतीर्थपदाभिहितः पठतस्तदिदं भवति ध्रुवमुच्चसुखम्॥",
"bg_patha": "[-]"
},
"74b339fd-8038-4596-a45b-59cd9cde8183": {
"setutila": "॥ इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते द्वादशस्तोत्रे चतुर्थोऽध्यायः॥",
"trk_patha": "॥ इति श्रीमद्द्वादशस्तोत्रे चतुर्थोऽध्यायः॥",
"bg_patha": "[॥ हरिस्तुतिः समाप्ता॥]"
}

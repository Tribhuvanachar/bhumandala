          [
            "ಜಯ ಜಯ ಜಗತ್ರಾಣ, ಜಗದೊಳಗೆ ಸೂತ್ರಾಣ",
            "ಅಖಿಲ ಗುಣ ಸಾಧ್ಧಾಮ ಮಧ್ವನಾಮ"
          ],
          [

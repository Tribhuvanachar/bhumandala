      "text": {
        "kannada": [
          [
            "ಕೃಷ್ಣ ನೀ ಬೇಗನೇ ಬಾರೋ |ಪ|",
            "ಬೇಗನೆ ಬಾರೋ ಮುಖವನ್ನು ತೋರೋ|ಅ.ಪ|"
          ],
          [
            "ಕಾಲಾಲಂದುಗೆ ಗೆಜ್ಜೆ ನೀಲದ ಭಾವುಳಿ",
            "ನೀಲವರ್ಣನೆ ನಾಟ್ಯವಾಡುತ್ತ ಬಾರೋ|"
          ],
          [
            "ಉಡಿಯಲ್ಲಿ ಉಡುಗೆಜ್ಜೆ ಬೆರಳಲ್ಲಿ ಉಂಗುರ",
            "ಕೊರಳಲ್ಲಿ ಹಾಕಿದ ವೈಜಯಂತಿಮಾಲ|"
          ],
          [
            "ತಾಯಿಗೆ ಬಾಯಲ್ಲಿ ಜಗವನ್ನು ತೋರಿದ",
            "ಜಗದೋದ್ಧಾರಕ ನಮ್ಮ ಉಡುಪಿ ಶ್ರೀ ಕೃಷ್ಣ|"
          ]
        ],
        "iast": [],
        "devanagari": [],
        "source_roman": [
          [
            "Krishna nee begane baaro",
            "Begane baaro mukavannu toro||"
          ],
          [
            "Kaalaal landhige gejje niladha baavuli",
            "Nilavarnane naatya vaaduta baaro||"
          ],
          [
            "Odiyalli Odigejje beralalli ongura",
            "Koralalli haakida vajayantimaale||1||"
          ],
          [
            "Kaasi peetambara kaiyalli kolalu",
            "Pushida shreegandha mayaolu gamma||2||"
          ],
          [
            "Taayige baayalli jagavannu torida",
            "Jagadhodhaaraka namma udupi shree Krishna ||3||"
          ]
        ]

          ],
          [
            "ಮೊಸರು ಮಾರುವ ಗೊಲ್ಲತಿಯರಅಸವಳಿಸಿ ಕೈಯ ಪಿಡಿದು",
            "ವಶನಾಗು ಎಂದು ಪೇಳಿನಸುನಗುತಲಿದ್ದೆಯಂತೆ ||1||"
          ],
          [

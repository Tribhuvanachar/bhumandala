      "title": {
        "kn": "ಎಲ್ಲಿ ಮಾಯಾವಾದನೆ ರಂಗಯ್ಯನು",
        "latin": "ಎಲ್ಲಿ ಮಾಯಾವಾದನೆ ರಂಗಯ್ಯನು",
        "iast": "èlli māyāvādanè raṃgayyanu",
        "devanagari": "ऎल्लि मायावादनॆ रंगय्यनु"
      },
      "composer": "ವ್ಯಾಸರಾಯರು",
      "composer_latin": "V Y A S A R A Y A R U",

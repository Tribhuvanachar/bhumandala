{
  "version": "1.0",

  "reader": {
    "defaultScript": "Devanagari",
    "defaultFontSize": 18,
    "minimumFontSize": 14,
    "maximumFontSize": 36,
    "lineHeight": 1.7,

    "showVerseNumber": true,
    "showTitle": true,
    "showMeaning": true,
    "showCommentary": false,

    "rememberFontSize": true,
    "rememberScript": true,
    "rememberLastVerse": true,

    "enableSelection": true,
    "enableCopy": true,
    "enableShare": true
  }
}

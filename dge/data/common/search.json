{
  "version": "1.0",

  "search": {
    "minimumCharacters": 2,
    "debounceMilliseconds": 250,
    "highlightMatches": true,
    "caseSensitive": false,
    "diacriticSensitive": false,
    "wholeWord": false,

    "fields": [
      "sanskrit",
      "transliteration",
      "meaning",
      "commentary",
      "notes",
      "tags"
    ],

    "maximumResults": 500,

    "rememberLastSearch": true
  }
}

      "text": {
        "kannada": [
          [
            "ಜಾರತ್ವವನು ಮಾಡಿದ ಪಾಪಗಳಿಗೆಲ್ಲಾ",
            "ಗೋಪೀಜನ ಜಾರನೆಂದರೆ ಸಾಲದೆ?",
            "ಚೋರತ್ವವನು ಮಾಡಿದ ಪಾಪಗಳಿಗೆಲ್ಲ",
            "ನವನೀತ ಚೋರನೆಂದರೆ ಸಾಲದೆ?",
            "ಕ್ರೂರತ್ವವನು ಮಾಡಿದ ಪಾಪಗಳಿಗೆಲ್ಲ",
            "ಮಾವನ ಕೊಂದವನೆಂದರೆ ಸಾಲದೆ?",
            "ಪ್ರತಿದಿವಸ ಮಾಡಿದ ಪಾಪಂಗಳಿಗೆ ಎಲ್ಲಾ",
            "ಪತಿತಪಾವನನೆಂದು ಕರೆದರೆ ಸಾಲದೆ?",
            "ಇಂತಿಪ್ಪ ಮಹಿಮೆಯೊಳೊಗೊಂದನ್ನಾದರೂ ಒಮ್ಮೆ",
            "ಸಂತಸದಿ ನೆನೆಯೆ ಸಲುವ ಸಿರಿಕೃಷ್ಣ ||"
          ],
          [
            "ಕಂಗಳು ಚೆಲುವನು ನೋಡಿ ಕರ್ಣಂಗಳು ವಾರುತಿಯ ಕೇಳಿ",
            "ಹಿಂಗದೆ ನಾಮವ ವದನದಿ ಸವಿಯುತ್ತ ಪದಂಗಳ ಮನದಿ ನೆನೆನೆನೆದು",
            "ರೋಮಂಗಳು ಪುಳಕಿತವಾಗಿ ಲೋಕಂಗಳ ಕಡಲೊಳು ಮುಳುಗಿ ಮೈಯುಬ್ಬಿ ಕೊಬ್ಬುತ್ತ",
            "ಅಂಗವ ಮೆರೆದಾನಂದದಿ ರಂಗಾ ಎನುತಿದ್ದರೆ ಸಾಲದೆ",
            "ಮಂಗಳ ಜಯವನ್ನು ಕರುಣಿಸೋ ಮತ್ತೊಂದು ಸಂಗವನೊಲ್ಲೆನೋ ಸಿರಿಕೃಷ್ಣರಾಯ||"
          ],
          [
            "ನೀರಿಲ್ಲದ ಭಾವಿ ಊರಿಲ್ಲದ ಮಠವು",
            "ನೆರಳಿಲ್ಲದ ಮರ ಫಲವಿಲ್ಲದ ಲತೆ",
            "ಧನವಿಲ್ಲದ ದಾತ ದಯವಿಲ್ಲದ ನಾಥ",
            "ಮನಸಿಲ್ಲದ ಶಕುತಿ ಭಯವಿಲ್ಲದ ಭಕುತಿ",
            "ನರಹರಿ ಮುಕುಂದ ಶ್ರೀಕೃಷ್ಣ ಎನ್ನದ",
            "ನರರಿದ್ದು ಫಲವೇನು ಇಲ್ಲದಿದ್ದರೆ ಏನು ||"
          ],
          [
            "ನಿನ್ನ ಎಂಜಲನುಂಡು ನಿನ್ನ ಬೆಳ್ಳುಡೆಯುಟ್ಟು",
            "ಮುನ್ನ ಮಾಡಿದ ಕರ್ಮ ಬೆನ್ನಬಿಡದಿದ್ದರೆ",
            "ನಿನ್ನ ಓಲೈಸಲೇಕೊ ಕೃಷ್ಣ",
            "ಸಂಚಿತವನುಂಡು ಪ್ರಪಂಚದೊಳಗೆ ಬಿದ್ದು",
            "ನಿನ್ನ ಓಲೈಸಲೇಕೋ ಕೃಷ್ಣ",
            "ದಿನಕರನುದಿಸಿ ಕತ್ತಲೆ ಪೋಗದಿದ್ದರೆ",
            "ಹಗಲೇನೋ ಇರುಳೇನೊ ಕುರುಡಂಗ ಸಿರಿಕೃಷ್ಣ||"
          ],
          [
            "ಆವ ಜನುಮದ ತಾಯಿ ಆವ ಜನುಮದ ತಂದೆ",
            "ಆವ ಜನುಮದ ಸತಿ ಆವಜನುಮದ ಸುತರು",
            "ಆವ ಜನುಮದ ಬಂಧು ಆವ ಜನುಮದ ಬಳಗ",
            "ಆವ ಜನುಮದ ಪಿಂಡ ಆವಂಗೆ ಜನಿಸುವೆವೊ",
            "ನೀ ವೊಲಿದು ಪಾಲಿಸೈ ಸಿರಿಕೃಷ್ಣರಾಯ||"
          ]
        ],
        "iast": [
          [
            "jāratvavanu māḍida pāpagaḻigèllā",
            "gopījana jāranèṃdarè sāladè?",
            "coratvavanu māḍida pāpagaḻigèlla",
            "navanīta coranèṃdarè sāladè?",
            "krūratvavanu māḍida pāpagaḻigèlla",
            "māvana kòṃdavanèṃdarè sāladè?",
            "pratidivasa māḍida pāpaṃgaḻigè èllā",
            "patitapāvananèṃdu karèdarè sāladè?",
            "iṃtippa mahimèyòḻògòṃdannādarū òmmè",
            "saṃtasadi nènèyè saluva sirikṛṣṇa ||"
          ],
          [
            "kaṃgaḻu cèluvanu noḍi karṇaṃgaḻu vārutiya keḻi",
            "hiṃgadè nāmava vadanadi saviyutta padaṃgaḻa manadi nènènènèdu",
            "romaṃgaḻu puḻakitavāgi lokaṃgaḻa kaḍalòḻu muḻugi maiyubbi kòbbutta",
            "aṃgava mèrèdānaṃdadi raṃgā ènutiddarè sāladè",
            "maṃgaḻa jayavannu karuṇiso mattòṃdu saṃgavanòllèno sirikṛṣṇarāya||"
          ],
          [
            "nīrillada bhāvi ūrillada maṭhavu",
            "nèraḻillada mara phalavillada latè",
            "dhanavillada dāta dayavillada nātha",
            "manasillada śakuti bhayavillada bhakuti",
            "narahari mukuṃda śrīkṛṣṇa ènnada",
            "narariddu phalavenu illadiddarè enu ||"
          ],
          [
            "ninna èṃjalanuṃḍu ninna bèḻḻuḍèyuṭṭu",
            "munna māḍida karma bènnabiḍadiddarè",
            "ninna olaisalekò kṛṣṇa",
            "saṃcitavanuṃḍu prapaṃcadòḻagè biddu",
            "ninna olaisaleko kṛṣṇa",
            "dinakaranudisi kattalè pogadiddarè",
            "hagaleno iruḻenò kuruḍaṃga sirikṛṣṇa||"
          ],
          [
            "āva janumada tāyi āva janumada taṃdè",
            "āva janumada sati āvajanumada sutaru",
            "āva janumada baṃdhu āva janumada baḻaga",
            "āva janumada piṃḍa āvaṃgè janisuvèvò",
            "nī vòlidu pālisai sirikṛṣṇarāya||"
          ]
        ],
        "devanagari": [
          [
            "जारत्ववनु माडिद पापगळिगॆल्ला",
            "गोपीजन जारनॆंदरॆ सालदॆ?",
            "चोरत्ववनु माडिद पापगळिगॆल्ल",
            "नवनीत चोरनॆंदरॆ सालदॆ?",
            "क्रूरत्ववनु माडिद पापगळिगॆल्ल",
            "मावन कॊंदवनॆंदरॆ सालदॆ?",
            "प्रतिदिवस माडिद पापंगळिगॆ ऎल्ला",
            "पतितपावननॆंदु करॆदरॆ सालदॆ?",
            "इंतिप्प महिमॆयॊळॊगॊंदन्नादरू ऒम्मॆ",
            "संतसदि नॆनॆयॆ सलुव सिरिकृष्ण ||"
          ],
          [
            "कंगळु चॆलुवनु नोडि कर्णंगळु वारुतिय केळि",
            "हिंगदॆ नामव वदनदि सवियुत्त पदंगळ मनदि नॆनॆनॆनॆदु",
            "रोमंगळु पुळकितवागि लोकंगळ कडलॊळु मुळुगि मैयुब्बि कॊब्बुत्त",
            "अंगव मॆरॆदानंददि रंगा ऎनुतिद्दरॆ सालदॆ",
            "मंगळ जयवन्नु करुणिसो मत्तॊंदु संगवनॊल्लॆनो सिरिकृष्णराय||"
          ],
          [
            "नीरिल्लद भावि ऊरिल्लद मठवु",
            "नॆरळिल्लद मर फलविल्लद लतॆ",
            "धनविल्लद दात दयविल्लद नाथ",
            "मनसिल्लद शकुति भयविल्लद भकुति",
            "नरहरि मुकुंद श्रीकृष्ण ऎन्नद",
            "नररिद्दु फलवेनु इल्लदिद्दरॆ एनु ||"
          ],
          [
            "निन्न ऎंजलनुंडु निन्न बॆळ्ळुडॆयुट्टु",
            "मुन्न माडिद कर्म बॆन्नबिडदिद्दरॆ",
            "निन्न ओलैसलेकॊ कृष्ण",
            "संचितवनुंडु प्रपंचदॊळगॆ बिद्दु",
            "निन्न ओलैसलेको कृष्ण",
            "दिनकरनुदिसि कत्तलॆ पोगदिद्दरॆ",
            "हगलेनो इरुळेनॊ कुरुडंग सिरिकृष्ण||"
          ],
          [
            "आव जनुमद तायि आव जनुमद तंदॆ",
            "आव जनुमद सति आवजनुमद सुतरु",
            "आव जनुमद बंधु आव जनुमद बळग",
            "आव जनुमद पिंड आवंगॆ जनिसुवॆवॊ",
            "नी वॊलिदु पालिसै सिरिकृष्णराय||"
          ]
        ],
        "source_roman": [
          [
            "jAratvavanu mADida pApagaLigellA",
            "gOpIjana jAranegdare sAlade?",
            "cOratvavanu mADida pApagaLigella",
            "navanIta cOranegdare sAlade?",
            "krUratvavanu mADida pApagaLigella",
            "mAvana kogdavanegdare sAlade?",
            "pratidivasa mADida pApaggaLige ellA",
            "patitapAvananegdu karedare sAlade?",
            "igtippa mahimeyoLogogdannAdarU omme",
            "santasadi neneye saluva sirikRuShNa |"
          ],
          [
            "kangaLu celuvanu nODi karNangaLu vArutiya kELi",
            "higgade nAmava vadanadi saviyutta padangaLa manadi nenenenedu",
            "rOmaggaLu puLakitavAgi lOkangaLa kaDaloLu muLugi maiyubbi kobbutta",
            "angava meredAnandadi rangA enutiddare sAlade",
            "mangaLa jayavannu karuNisO mattondu sangavanollenO sirikRuShNarAya||"
          ],
          [
            "nIrillada BAvi Urillada maThavu",
            "neraLillada mara Palavillada late",
            "dhanavillada dAta dayavillada nAtha",
            "manasillada Sakuti Bayavillada Bakuti",
            "narahari mukunda SrIkRuShNa ennada",
            "narariddu PalavEnu illadiddare Enu"
          ],
          [
            "ninna enjalanunDu ninna beLLuDeyuTTu",
            "munna mADida karma bennabiDadiddare",
            "ninna OlaisalEko kRuShNa",
            "sancitavanuMDu prapancadoLage biddu",
            "ninna OlaisalEkO kRuShNa",
            "dinakaranudisi kattale pOgadiddare",
            "hagalEnO iruLEno kuruDanga sirikRuShNa"
          ],
          [
            "Ava janumada tAyi Ava janumada tande",
            "Ava janumada sati Avajanumada sutaru",
            "Ava janumada bandhu Ava janumada baLaga",
            "Ava janumada pinDa Avange janisuvevo",
            "nI volidu pAlisai sirikRuShNarAya"
          ]
        ]
      },

    {
      "id": "helavanakatte_giriyamma__97b7a21d",
      "form": "pada",
      "title": {
        "kn": "",
        "latin": "Enidu bayala pasa nodidarilla",
        "iast": "",
        "devanagari": ""
      },
      "composer": "Helavanakatte Giriyamma",
      "deity": "",
      "tags": [

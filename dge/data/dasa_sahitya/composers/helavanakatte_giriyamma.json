    {
      "id": "helavanakatte_giriyamma__f2b616e1",
      "form": "pada",
      "title": {
        "kn": "",
        "latin": "Rama sri ragunandana saranu",
        "iast": "",
        "devanagari": ""
      },
      "composer": "Helavanakatte Giriyamma",
      "deity": "Rama",
      "tags": [
        "composer:Helavanakatte Giriyamma",
        "deity:Rama"
      ],
      "raga": "",
      "tala": "",
      "language": "kn",
      "text": {
        "kannada": [
          [
            "ರಾಮ ಶ್ರೀ ರಘುನಂದನ ಶರಣು ಸಾರ್ವ-",
            "ಭೌಮ ಭೂಸುರವಂದ್ಯ",
            "ಸೋಮಶೇಖರಮಿತ್ರ ಕಾಮಿತ ಫಲದಾತ್ರ",
            "ಕಾಮಧೇನು ವಿಶ್ವಭೀಮ ಸನ್ನುತ ಸೀತಾ ||pa||"
          ],
          [
            "ಕ್ರೂರ ದಾನವ ಸಂಹಾರ ಕೌಸಲ್ಯಾಕುಮಾರ ಭೂ-",
            "ಭಾರಹರ ಭಜಕÀಜನೋದ್ಧಾರ ವೇದಾಂತಸಾರ",
            "ಚಾರುವದನ ಮಣಿಹಾರ ಕುಂಡಲಧರ",
            "ವೀರರಾಘವ ವಿಶ್ವಾಧಾರ ಕರುಣಿಸು ಸೀತಾ ||1||"
          ],
          [
            "ಪಾಪರಹಿತ ಪಾವನ ಚರಿತ ಅಹಲ್ಯಾ",
            "ಶಾಪ ಹರಣ ದಿವ್ಯರೂಪ ರಮಾರಮಣ",
            "ತಾಪ ವಿಚ್ಛೇದನ ತಾಮಸ ಗುಣಹರಣ ದ-",
            "ಯಾಪರ ಬ್ರಹ್ಮಸ್ವರೂಪ ಮೂರುತಿ ಸೀತಾ ||2||"
          ],
          [
            "ಮದನಕೋಟಿ ಮೋಹನಾಂಗ ಮಾಧವ ಪುಣ್ಯಚರಿತ",
            "ಕರುಣಾಪಾಂಗ ಹೆಳವನಕಟ್ಟೆ ರಂಗಯ್ಯ",
            "ಸದಾನಂದ ಸುಮತೀಂದ್ರ ಹೃದಯ ಪಂಕಜಭೃಂಗ",
            "ಕದನ ವಿಕ್ರಮ ಬಾಹು ಕೋದಂಡಧೃತ ಸೀತಾ||3||"
          ]
        ],
        "iast": [
          [
            "rāma śrī raghunaṃdana śaraṇu sārva-",
            "bhauma bhūsuravaṃdya",
            "somaśekharamitra kāmita phaladātra",
            "kāmadhenu viśvabhīma sannuta sītā ||pa||"
          ],
          [
            "krūra dānava saṃhāra kausalyākumāra bhū-",
            "bhārahara bhajakaÀjanoddhāra vedāṃtasāra",
            "cāruvadana maṇihāra kuṃḍaladhara",
            "vīrarāghava viśvādhāra karuṇisu sītā ||1||"
          ],
          [
            "pāparahita pāvana carita ahalyā",
            "śāpa haraṇa divyarūpa ramāramaṇa",
            "tāpa vicchedana tāmasa guṇaharaṇa da-",
            "yāpara brahmasvarūpa mūruti sītā ||2||"
          ],
          [
            "madanakoṭi mohanāṃga mādhava puṇyacarita",
            "karuṇāpāṃga hèḻavanakaṭṭè raṃgayya",
            "sadānaṃda sumatīṃdra hṛdaya paṃkajabhṛṃga",
            "kadana vikrama bāhu kodaṃḍadhṛta sītā||3||"
          ]
        ],
        "devanagari": [
          [
            "राम श्री रघुनंदन शरणु सार्व-",
            "भौम भूसुरवंद्य",
            "सोमशेखरमित्र कामित फलदात्र",
            "कामधेनु विश्वभीम सन्नुत सीता ||pa||"
          ],
          [
            "क्रूर दानव संहार कौसल्याकुमार भू-",
            "भारहर भजकÀजनोद्धार वेदांतसार",
            "चारुवदन मणिहार कुंडलधर",
            "वीरराघव विश्वाधार करुणिसु सीता ||1||"
          ],
          [
            "पापरहित पावन चरित अहल्या",
            "शाप हरण दिव्यरूप रमारमण",
            "ताप विच्छेदन तामस गुणहरण द-",
            "यापर ब्रह्मस्वरूप मूरुति सीता ||2||"
          ],
          [
            "मदनकोटि मोहनांग माधव पुण्यचरित",
            "करुणापांग हॆळवनकट्टॆ रंगय्य",
            "सदानंद सुमतींद्र हृदय पंकजभृंग",
            "कदन विक्रम बाहु कोदंडधृत सीता||3||"
          ]
        ],
        "source_roman": [
          [
            "Rama sri ragunandana saranu | sarva |",
            "Bauma busura vandya || pa ||"
          ],
          [
            "Somasekara mitra kamita paladata |",
            "Kamadhenu visva bima sannuta sita || A. Pa ||"
          ],
          [
            "Krura danava samhara kausalya kumara | BU |",
            "Bara hara Bajaka janoddhara vedantasara |",
            "Caruvadana mani hara kundaladhara |",
            "Vira ragava visvadhara karunisu sita || 1 ||"
          ],
          [
            "Papa rahita pavana carita ahalya |",
            "Sapa harana divya rupa ramaramana |",
            "Tapa viccedana tamasa guna harana | da |",
            "Ya parabrahma svarupa muruti sita || 2 ||"
          ],
          [
            "Madanakoti mohananga madhava punyacharita |",
            "Karunapamga helavanakatte rangayya |",
            "Sadanamda sumatimdra |hrudayabja brunga |",
            "Kadana vikrama bahu kodandadhruta sita || 3 ||"
          ]
        ]
      },
      "meaning": "",

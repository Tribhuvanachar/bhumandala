{
  "indexes": [
    {
      "//": "Backs the scheduled broadcast's 'which campaigns are due' query (status == 'scheduled' AND sendAfter <= now). Firestore requires a composite index for an equality + range pair on different fields.",
      "collectionGroup": "broadcasts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "sendAfter", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Backs Manage Users' most-recently-active listing.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "lastLoginAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
